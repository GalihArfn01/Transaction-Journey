<?xml version="1.0" encoding="utf-8"?>
<!-- Kartu "Hari Ini" — layout mengikuti Home Screen Widgets.dc.html,
     tapi palet warna (@color/widget_*) diselaraskan ke desain utama app
     (biru terang), bukan Nocturne gelap aslinya. Lihat widget_colors.xml.

     Struktur: root TANPA padding — strip header gradient biru
     (widget_header_bg, radius atas 14dp menyatu dengan kartu) mengisi
     lebar penuh bagian atas, lalu body putih ber-padding di bawahnya —
     sama seperti widget_saldo.xml. (Tidak memakai trik margin negatif —
     itu rapuh di beberapa launcher.) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg">

    <!-- Header gradient biru penuh (meniru AppBar app utama) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/widget_header_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="HARI INI"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:letterSpacing="0.12"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/iconbtn_on_accent_bg"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:tint="#FFFFFF"
            android:contentDescription="Segarkan ringkasan"
            android:src="@drawable/ic_widget_refresh" />
    </LinearLayout>

    <!-- Body putih -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/circle_accent_bg"
                    android:padding="8dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_arrow_down_left" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pemasukan"
                        android:textColor="@color/widget_text_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_income_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+Rp 0"
                        android:textColor="@color/widget_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/circle_neutral_bg"
                    android:padding="8dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_arrow_up_right" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pengeluaran"
                        android:textColor="@color/widget_text_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_expense_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-Rp 0"
                        android:textColor="@color/widget_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pb_income_share"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/progress_income_share" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_net_amount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bersih: +Rp 0"
                android:textColor="@color/widget_text"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reset tengah malam"
                android:textColor="@color/widget_text_muted"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
